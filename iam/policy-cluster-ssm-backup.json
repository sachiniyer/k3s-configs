{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadClusterParametersOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParametersByPath",
        "ssm:GetParameters",
        "ssm:GetParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": [
        "arn:aws:ssm:us-east-1:*:parameter/cluster",
        "arn:aws:ssm:us-east-1:*:parameter/cluster/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringsViaSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "WriteOnlyToSsmBackupPrefix",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::sachiniyer-cluster-backups/ssm/*"
    }
  ]
}
